# Aaspaas Backend — Environment Configuration
# Copy this file to .env and fill in values before running the backend.
# NEVER commit .env to source control.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
# Local Docker development credentials (matches docker-compose.yml)
DATABASE_URL=postgresql://aaspaas:aaspaas_dev_password@localhost:5432/aaspaas_db

# Set to 'true' to enable SSL (required in production/staging).
DATABASE_SSL=false

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local Docker development credentials (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aaspaas_redis_dev_password

# ── JWT (Phase 2) ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_at_least_64_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP & Abuse Protection (Phase 2) ──────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
# Leave empty or unset for development (all origins allowed).
# ALLOWED_ORIGINS=https://app.aaspaas.in,https://admin.aaspaas.in

# ── Push Notifications (Phase 9 — Optional in dev, required for real FCM push) ─
# If unset, FCM push provider runs in dev fallback mode (in-app notifications only).
# FCM_PROJECT_ID=aaspaas-app
# FIREBASE_SERVICE_ACCOUNT_KEY=path/to/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-adminsdk.json

